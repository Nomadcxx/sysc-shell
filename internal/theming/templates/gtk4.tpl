/* GTK 4 and libadwaita semantic colors from the active sysc-shell palette. */
@define-color window_bg_color {{.Surface}};
@define-color window_fg_color {{.OnSurface}};
@define-color view_bg_color {{.Surface}};
@define-color view_fg_color {{.OnSurface}};

@define-color headerbar_bg_color {{.SurfaceContainer}};
@define-color headerbar_fg_color {{.OnSurface}};
@define-color card_bg_color {{.SurfaceContainerLow}};
@define-color card_fg_color {{.OnSurface}};
@define-color dialog_bg_color {{.SurfaceContainerHigh}};
@define-color dialog_fg_color {{.OnSurface}};
@define-color popover_bg_color {{.SurfaceContainerHigh}};
@define-color popover_fg_color {{.OnSurface}};
@define-color sidebar_bg_color {{.SurfaceContainerLow}};
@define-color sidebar_fg_color {{.OnSurface}};
@define-color sidebar_border_color {{.OutlineVariant}};
@define-color sidebar_backdrop_color {{.Surface}};

@define-color accent_color {{.Primary}};
@define-color accent_bg_color {{.Primary}};
@define-color accent_fg_color {{.OnPrimary}};
@define-color destructive_color {{contrast .Error .Surface}};
@define-color destructive_bg_color {{.Error}};
@define-color destructive_fg_color {{.OnError}};
@define-color success_color {{contrast .Secondary .Surface}};
@define-color success_bg_color {{.Secondary}};
@define-color success_fg_color {{.OnSecondary}};
@define-color warning_color {{contrast .Tertiary .Surface}};
@define-color warning_bg_color {{.Tertiary}};
@define-color warning_fg_color {{.OnTertiary}};
@define-color error_color {{contrast .Error .Surface}};
@define-color error_bg_color {{.Error}};
@define-color error_fg_color {{.OnError}};

@define-color theme_bg_color {{.Surface}};
@define-color theme_fg_color {{.OnSurface}};
@define-color theme_base_color {{.Surface}};
@define-color theme_text_color {{.OnSurface}};
@define-color theme_selected_bg_color {{.Primary}};
@define-color theme_selected_fg_color {{.OnPrimary}};
